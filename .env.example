# Telegram Bot Token (required)
BOT_TOKEN=your_bot_token_here

# Company & Officer Information
COMPANY_NAME=Your Company Name
OFFICER_NAME=Officer Name
DESIGNATION=Designation
POSTING_AREA=Area
MOTORCYCLE_BRAND=Bike Brand
DEPO_NAME=Depo Name

# MongoDB (for Render deployment — omit for local file-based storage)
MONGODB_URL=
MONGODB_DB_NAME=pathikbot

# Telegram channel for permanent file storage (bot must be admin)
STORAGE_CHANNEL_ID=@your_channel_username_or_numeric_id

# PDF conversion (enabled by default; set to false to skip)
# Requires Java 17+ installed (for Aspose.Words JAR via JPype)
PDF_ENABLED=true
