# Telegram Bot Token (required)
BOT_TOKEN=your_bot_token_here

# Company & Officer Information
COMPANY_NAME=Your Company Name
OFFICER_NAME=Officer Name
DESIGNATION=Designation
POSTING_AREA=Area
MOTORCYCLE_BRAND=Bike Brand
DEPO_NAME=Depo Name

# MongoDB (for Render deployment — omit for local file-based storage)
MONGODB_URL=
MONGODB_DB_NAME=pathikbot

# Telegram channel for permanent file storage (bot must be admin)
STORAGE_CHANNEL_ID=@your_channel_username_or_numeric_id

# PDF conversion (enabled by default; set to false to skip)
# Requires Java 17+ installed (for Aspose.Words JAR via JPype)
PDF_ENABLED=true

# ---------------------------------------------------------------------------
# Web API (FastAPI layer exposed by web_api/launcher.py)
# ---------------------------------------------------------------------------

# Long random string used to sign web session JWTs
WEB_JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the web API (CORS).
# Example: https://your-app.lovable.app,https://your-domain.com
# Use * only for local testing.
WEB_ALLOWED_ORIGINS=*

# Numeric Telegram user id of the owner (required for /api/admin/* routes)
OWNER_TELEGRAM_ID=

# Set to 1 to disable the Telegram bot thread inside web_api.launcher
# (useful if you run the bot as a separate Render service).
# DISABLE_BOT=1

# Set automatically by web_api/launcher.py — do not set manually.
# Tells bot/main.py to skip its built-in health HTTP server so uvicorn
# can own $PORT.
# SKIP_HEALTH_SERVER=1
